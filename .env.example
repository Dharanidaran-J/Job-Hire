# ==========================================
# ChallengeHire Environment Configuration
# ==========================================

# Flask Secret Key for Sessions
SECRET_KEY=dev-challengehire-secret-key-super-secure-2025

# Database Configuration
# Option A: MySQL (Default in production/DBMS)
# Example: mysql+pymysql://root:password@localhost:3306/challengehire_db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/challengehire_db

# Option B: Fallback to SQLite if MySQL is not reachable or set to empty
USE_SQLITE_FALLBACK=true

# AI Configuration (Optional Gemini API key for live LLM evaluations)
# Leave empty to use the built-in intelligent rule-based / heuristic evaluation engine
GEMINI_API_KEY=

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
